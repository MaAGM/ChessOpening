NEXT_PUBLIC_LICHESS_TOKEN=

# Convex (écrites par `npx convex dev`). Sans elles, l'application reste en mode invité.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Les secrets d'authentification vivent sur le déploiement Convex, pas ici :
#   npx convex env set BETTER_AUTH_SECRET <aléatoire>
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set GOOGLE_CLIENT_ID <id>
#   npx convex env set GOOGLE_CLIENT_SECRET <secret>
